{
    "name":  "botim-pdf-editor",
    "version":  "1.2.0",
    "description":  "BOTIM PDF EDITOR by Otim Noah - text, images, annotations, signatures, form fields, cover merge. Save as PDF without Word conversion.",
    "author":  "Otim Noah \u003cotim.noah@example.com\u003e",
    "main":  "electron/main.js",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "electron":  "electron electron/main.js",
                    "electron:dev":  "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 \u0026\u0026 electron electron/main.js\"",
                    "dist":  "vite build; if ($?) { electron-builder --win --x64 }",
                    "pack":  "electron-builder --dir"
                },
    "dependencies":  {
                         "pdf-lib":  "^1.17.1",
                         "pdfjs-dist":  "^4.4.168"
                     },
    "devDependencies":  {
                            "concurrently":  "^8.2.2",
                            "electron":  "^31.0.0",
                            "electron-builder":  "^24.13.3",
                            "electron-packager":  "^17.1.2",
                            "vite":  "^5.4.0",
                            "wait-on":  "^7.2.0"
                        },
    "build":  {
                  "appId":  "com.botim.pdfeditor",
                  "productName":  "BOTIM PDF EDITOR",
                  "copyright":  "Copyright Â© 2026 Otim Noah â€” BOTIM PDF EDITOR",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "target":  [
                                             "nsis",
                                             "portable"
                                         ],
                              "icon":  "public/icon.png",
                              "publisherName":  "Otim Noah",
                              "verifyUpdateCodeSignature":  false,
                              "signAndEditExecutable":  false,
                              "signDlls":  false
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "BOTIM PDF EDITOR",
                               "displayLanguageSelector":  false,
                               "installerIcon":  "public/icon.png",
                               "uninstallerIcon":  "public/icon.png",
                               "artifactName":  "BOTIM-PDF-EDITOR-Setup-${version}.exe",
                               "include":  "installer.nsh"
                           },
                  "portable":  {
                                   "artifactName":  "BOTIM-PDF-EDITOR-Portable-${version}.exe"
                               }
              }
}